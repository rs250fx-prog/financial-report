---
import { PUBLISHER, PUBLISHER_URL } from '../config';
---

<section class="sec">
  <div class="colo">
    <a class="cc" href={PUBLISHER_URL}>
      <span class="av" aria-hidden="true"></span>
      <div>
        <div class="r">運営元</div>
        <h2>{PUBLISHER}</h2>
        <p>
          金融出身のWebマーケティング・スタジオ。中小企業向けのサイト改善・LP制作・SEO内部設計・AI導入支援を行っています。
        </p>
        <span class="go">fam16.com を見る →</span>
      </div>
    </a>

    <div class="cc">
      <div>
        <div class="r">編集方針</div>
        <h2>読んだ人が、自分で判断できるように</h2>
        <p>
          結論だけを配る媒体にはしません。どのデータを、どう解釈して、その結論に至ったか。判断の過程を毎日残していくことを方針としています。
        </p>
        <a class="go" href="/about/">方針の全文を読む →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .sec { padding: 60px 0; border-bottom: 1px solid var(--line); }
  .colo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .cc {
    display: flex;
    gap: 22px;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 30px 32px;
    transition: border-color .2s;
  }
  .cc:hover { border-color: var(--line-2); }
  .av {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 12px;
    background: linear-gradient(140deg, var(--ink) 0%, var(--muted) 100%);
  }
  .r {
    font-family: var(--sa);
    font-size: 10.5px;
    letter-spacing: .14em;
    color: var(--muted);
    margin-bottom: 7px;
  }
  h2 {
    font-family: var(--se);
    font-size: 19px;
    font-weight: 500;
    margin-bottom: 8px;
  }
  p {
    font-size: 13.5px;
    line-height: 1.9;
    font-weight: 300;
    color: var(--muted);
  }
  .go {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--sa);
    font-size: 12.5px;
    color: var(--accent);
  }
  @media (max-width: 820px) {
    .colo { grid-template-columns: 1fr; }
  }
</style>
