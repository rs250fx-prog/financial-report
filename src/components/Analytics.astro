---
import { GA4_MEASUREMENT_ID } from '../config';

/**
 * Google Analytics 4。
 *
 * 測定IDが空のあいだは何も出力しない。IDを入れた時点で計測が始まり、
 * プライバシーポリシーの GA4 に関する記述も同時に表示される。
 *
 * 読み込みは async にしてレンダリングをブロックさせない。gtag.js は
 * 約50KB あり、外部リクエストを0件にしたページに戻す追加コストなので、
 * 計測が不要になったら ID を空にして落とすこと。
 */
const id = GA4_MEASUREMENT_ID;
---

{id && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
    <script is:inline define:vars={{ id }}>
      window.dataLayer = window.dataLayer || [];
      // Astro はインラインスクリプトを IIFE で包むため、
      // window に生やさないと後からイベント計測を足せない
      window.gtag = function gtag() { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      // IPの匿名化は GA4 では既定で有効。ここでは明示的な設定のみ行う
      window.gtag('config', id);
    </script>
  </>
)}
