---
/**
 * マーケット・スナップショット。
 * 案Aの数値ボードを、案Cのカードグリッドで表現したもの。
 * 6枠を想定しているが、件数が変わっても崩れないよう
 * グリッドは列数固定 + 罫線の打ち消しで組む。
 */
interface Quote {
  label: string;
  value: string;
  change: string;
  dir: 'up' | 'down' | 'flat';
}
interface Props {
  quotes: Quote[];
  /** 更新時刻など、右上に添えるメモ */
  note?: string;
  /**
   * board は横に並べる盤面（既定）。list は1指標1行の縦並びで、
   * 記事ページの右列のように幅が取れない場所に置く。
   */
  variant?: 'board' | 'list';
  /** board の広い幅での列数。本文幅に収める記事ページは 4（8件が4×2に揃う） */
  cols?: 4 | 6;
}
const { quotes, note, variant = 'board', cols = 6 } = Astro.props;
---

{quotes.length > 0 && variant === 'board' && (
  <section class="snap-wrap" aria-label="マーケット・スナップショット">
    <div class:list={['snap', cols === 4 && 'c4']}>
      {quotes.map((q) => (
        <div class="sc">
          <b>{q.label}</b>
          <div class="v">{q.value}</div>
          <div class:list={['c', q.dir]}>{q.change}</div>
        </div>
      ))}
    </div>
    {note && <p class="note">{note}</p>}
  </section>
)}

{quotes.length > 0 && variant === 'list' && (
  <section class="snap-list" aria-label="マーケット・スナップショット">
    <div class="sl-h">数値指標</div>
    <ul>
      {quotes.map((q) => (
        <li>
          <b>{q.label}</b>
          <span class="v">{q.value}</span>
          <span class:list={['c', q.dir]}>{q.change}</span>
        </li>
      ))}
    </ul>
    {note && <p class="note">{note}</p>}
  </section>
)}

<style>
  .snap-wrap { margin-top: 26px; }
  .snap {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    overflow: hidden;
  }
  .sc {
    padding: 19px 20px;
    border-right: 1px solid var(--line);
  }
  .sc:last-child { border-right: 0; }
  .sc b {
    display: block;
    font-family: var(--sa);
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: .06em;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .sc .v {
    font-family: var(--sa);
    font-size: 19px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.01em;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .sc .c {
    font-family: var(--sa);
    font-size: 11.5px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .c.up { color: var(--up); }
  .c.down { color: var(--down); }
  .c.flat { color: var(--muted); }

  .note {
    font-family: var(--sa);
    font-size: 11.5px;
    color: var(--muted);
    text-align: right;
    margin-top: 10px;
  }

  /* 4列。狭い幅の3列・2列の規則と罫線の打ち消しがぶつからないよう、広い幅に限る */
  @media (min-width: 921px) {
    .snap.c4 { grid-template-columns: repeat(4, 1fr); }
    .snap.c4 .sc { border-bottom: 1px solid var(--line); }
    .snap.c4 .sc:nth-child(4n) { border-right: 0; }
    .snap.c4 .sc:nth-last-child(-n + 4) { border-bottom: 0; }
  }

  /* 縦並び。ラベル・値・変化を1行に収める */
  .snap-list {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 16px 18px 8px;
  }
  .sl-h {
    font-family: var(--sa);
    font-size: 10.5px;
    letter-spacing: .16em;
    color: var(--muted);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-2);
  }
  .snap-list ul { list-style: none; }
  .snap-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 62px;
    gap: 10px;
    align-items: baseline;
    padding: 7px 0;
    line-height: 1.4;
    border-bottom: 1px solid var(--line);
    font-family: var(--sa);
    font-variant-numeric: tabular-nums;
  }
  .snap-list li:last-child { border-bottom: 0; }
  .snap-list b {
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: .04em;
    color: var(--muted);
  }
  .snap-list .v {
    font-size: 14.5px;
    font-weight: 500;
    letter-spacing: -.01em;
    text-align: right;
  }
  .snap-list .c {
    font-size: 11px;
    font-weight: 500;
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 920px) {
    .snap { grid-template-columns: repeat(3, 1fr); }
    .sc { border-bottom: 1px solid var(--line); }
    .sc:nth-child(3n) { border-right: 0; }
    .sc:nth-last-child(-n + 3) { border-bottom: 0; }
  }
  @media (max-width: 540px) {
    .snap { grid-template-columns: repeat(2, 1fr); }
    .sc:nth-child(3n) { border-right: 1px solid var(--line); }
    .sc:nth-child(2n) { border-right: 0; }
    .sc:nth-last-child(-n + 3) { border-bottom: 1px solid var(--line); }
    .sc:nth-last-child(-n + 2) { border-bottom: 0; }
  }
</style>
