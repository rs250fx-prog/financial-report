---
import { IS_PUBLIC, SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** 記事ページなら 'article' */
  type?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  /** frontmatter の unlisted。true なら noindex */
  unlisted?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  type = 'website',
  ogImage = '/og-default.png',
  publishedTime,
  modifiedTime,
  unlisted = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} — 資金の流れで読む、今日の市場`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogUrl = new URL(ogImage, SITE_URL).href;

// 本公開前と unlisted 記事は検索エンジンに載せない
const noindex = !IS_PUBLIC || unlisted;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:locale" content="ja_JP" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{IS_PUBLIC && <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />}
