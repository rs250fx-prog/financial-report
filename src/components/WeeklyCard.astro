---
import type { Weekly } from '../lib/content';
import { monthDay } from '../lib/content';

interface Props {
  entry: Weekly;
}
const { entry } = Astro.props;
const { week, start, end, title, deck } = entry.data;
---

<a class="wc" href={`/weekly/${entry.id}/`}>
  <div class="w">WEEK {week} — {monthDay(start)} / {monthDay(end)}</div>
  <h3>{title}</h3>
  <p>{deck}</p>
  <span class="go">読む →</span>
</a>

<style>
  .wc {
    display: flex;
    flex-direction: column;
    gap: 11px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 28px;
    transition: .2s;
  }
  .wc:hover {
    border-color: var(--line-2);
    transform: translateY(-2px);
  }
  .w {
    font-family: var(--sa);
    font-size: 11px;
    letter-spacing: .1em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-family: var(--se);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.6;
  }
  p {
    font-size: 13.5px;
    line-height: 1.9;
    font-weight: 300;
    color: var(--muted);
  }
  .go {
    margin-top: auto;
    padding-top: 12px;
    font-family: var(--sa);
    font-size: 12.5px;
    color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .wc:hover { transform: none; }
  }
</style>
