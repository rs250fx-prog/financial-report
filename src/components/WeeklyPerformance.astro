---
/**
 * 各資産の週次パフォーマンス。
 *
 * 日次のスナップショットは「いまの値」を並べる数値ボードだが、
 * 週次は値に寸評が付く。1週間を振り返る記事なので、数字だけでは
 * 何が起きたのかが伝わらないため。
 */
interface Row {
  label: string;
  value: string;
  change: string;
  dir: 'up' | 'down' | 'flat';
  note: string;
}
interface Props {
  rows: Row[];
}
const { rows } = Astro.props;
---

{rows.length > 0 && (
  <section class="perf" aria-label="各資産の週次パフォーマンス">
    <div class="sec-head">
      <h2>各資産の週次パフォーマンス</h2>
      <span class="spacer"></span>
      <span class="num">{rows.length} 銘柄</span>
    </div>
    <ul>
      {rows.map((r) => (
        <li>
          <span class="label">{r.label}</span>
          <span class="value">{r.value}</span>
          {r.change && <span class:list={['change', r.dir]}>{r.change}</span>}
          {r.note && <span class="note">{r.note}</span>}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .perf { margin: 34px 0 44px; }
  ul { list-style: none; }
  li {
    display: grid;
    grid-template-columns: 150px 120px 88px 1fr;
    gap: 6px 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  li:last-child { border-bottom: 0; }
  .label {
    font-family: var(--sa);
    font-size: 12.5px;
    color: var(--muted);
    letter-spacing: .02em;
  }
  .value {
    font-family: var(--sa);
    font-size: 17px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.01em;
  }
  .change {
    font-family: var(--sa);
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .change.up { color: var(--up); }
  .change.down { color: var(--down); }
  .change.flat { color: var(--muted); }
  .note {
    font-size: 14px;
    line-height: 1.8;
    color: var(--ink-2);
  }

  /* 狭い幅では、銘柄名と値を1行目に、寸評を下へ回す */
  @media (max-width: 760px) {
    li {
      grid-template-columns: 1fr auto auto;
      gap: 4px 12px;
    }
    .label { grid-area: 1 / 1; }
    .value { grid-area: 1 / 2; font-size: 16px; }
    .change { grid-area: 1 / 3; }
    .note { grid-column: 1 / -1; font-size: 13.5px; }
  }
</style>
