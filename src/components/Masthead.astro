---
import { SITE_NAME, SITE_NAME_JA, SITE_TAGLINE, CADENCE } from '../config';
import { longDate } from '../lib/content';

interface Props {
  /** 最新レポートの日付 'YYYY-MM-DD'。省略時は日付行を出さない */
  date?: string;
  /** 最新レポートの号数 */
  no?: number;
  /** TOP以外では h1 をサイト名にしない（記事タイトルが h1 になるため） */
  asHeading?: boolean;
}
const { date, no, asHeading = false } = Astro.props;
const Wordmark = asHeading ? 'h1' : 'p';
---

<div class="wrap">
  <div class="mast">
    {no !== undefined && <span class="edge l">No. {no}</span>}
    <span class="edge r">{CADENCE}</span>
    {date && <div class="date">{longDate(date)}</div>}
    <Wordmark class="wordmark"><a href="/">{SITE_NAME}</a></Wordmark>
    <div class="tagline">
      <span class="ja">{SITE_NAME_JA}</span>
      <span class="sep" aria-hidden="true"></span>
      {SITE_TAGLINE}
    </div>
  </div>
</div>

<style>
  .mast {
    position: relative;
    padding: 30px 0 22px;
    text-align: center;
  }
  .date {
    font-family: var(--sa);
    font-size: 11px;
    letter-spacing: .16em;
    color: var(--muted);
    margin-bottom: 14px;
  }
  /* 短い語なので字間を広く取り、マストヘッドとしての格を出す。
     text-indent は letter-spacing が末尾にも入るぶんの中央ずれを打ち消す */
  .wordmark {
    font-family: var(--se);
    font-size: clamp(30px, 6.4vw, 60px);
    font-weight: 500;
    letter-spacing: .2em;
    line-height: 1.1;
    text-indent: .2em;
  }
  .tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-family: var(--sa);
    font-size: 11px;
    letter-spacing: .2em;
    color: var(--muted);
    margin-top: 16px;
  }
  /* 漢字表記は補助。ローマ字の読みを示しつつ、日本語の語としても残す */
  .tagline .ja {
    font-family: var(--se);
    font-size: 13px;
    letter-spacing: .14em;
    color: var(--ink-2);
  }
  .tagline .sep {
    width: 14px;
    height: 1px;
    background: var(--line-2);
    display: block;
    flex: none;
  }
  @media (max-width: 520px) {
    .tagline { font-size: 10px; letter-spacing: .12em; gap: 9px; }
  }
  .edge {
    position: absolute;
    top: 34px;
    font-family: var(--sa);
    font-size: 10.5px;
    letter-spacing: .1em;
    color: var(--muted);
  }
  .edge.l { left: 24px; }
  .edge.r { right: 24px; }
  /* 両端のメタは、媒体名と衝突する幅で退避させる */
  @media (max-width: 760px) {
    .edge { display: none; }
  }
</style>
