---
import { SUBSCRIBE_ACTION } from '../config';

const ready = SUBSCRIBE_ACTION !== '';
---

<section id="subscribe" class="sec">
  <div class="sub">
    <div class="r">SUBSCRIBE</div>
    <h2>デイリーレポートを、毎朝メールで。</h2>
    <p>平日朝7時30分、その日の資金の流れを1通にまとめて配信します。購読は無料です。</p>

    <form
      class="form"
      action={ready ? SUBSCRIBE_ACTION : undefined}
      method="post"
      aria-describedby="subscribe-note"
    >
      <label class="visually-hidden" for="subscribe-email">メールアドレス</label>
      <input
        id="subscribe-email"
        type="email"
        name="email"
        placeholder="メールアドレス"
        required
        disabled={!ready}
      />
      <button type="submit" disabled={!ready}>
        {ready ? '購読する' : '準備中'}
      </button>
    </form>

    <p class="note" id="subscribe-note">
      {ready
        ? '配信解除はいつでも1クリックで。メールアドレスを第三者に提供することはありません。'
        : 'メール配信は準備中です。開始までもうしばらくお待ちください。'}
    </p>
  </div>
</section>

<style>
  .sec { padding: 60px 0; border-bottom: 1px solid var(--line); }
  .sub {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 56px 48px;
    text-align: center;
  }
  .r {
    font-family: var(--sa);
    font-size: 10.5px;
    letter-spacing: .18em;
    color: var(--accent);
    margin-bottom: 16px;
  }
  h2 {
    font-family: var(--se);
    font-size: clamp(24px, 3.2vw, 34px);
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: 14px;
  }
  .sub > p {
    font-size: 14.5px;
    font-weight: 300;
    color: var(--ink-2);
    max-width: 47ch;
    margin: 0 auto 28px;
  }
  .form {
    display: flex;
    gap: 8px;
    max-width: 440px;
    margin: 0 auto;
  }
  input {
    flex: 1;
    background: var(--surface);
    border: 1px solid var(--line-2);
    color: var(--ink);
    padding: 14px 18px;
    border-radius: 999px;
    font-family: var(--sa);
    font-size: 14px;
  }
  input::placeholder { color: var(--muted); }
  input:focus { outline: none; border-color: var(--ink); }
  button {
    background: var(--ink);
    color: var(--bg);
    border: 0;
    padding: 0 26px;
    border-radius: 999px;
    font-family: var(--sa);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
  }
  input:disabled, button:disabled { opacity: .5; cursor: not-allowed; }
  .note {
    font-family: var(--sa);
    font-size: 12px;
    color: var(--muted);
    margin-top: 16px;
  }
  @media (max-width: 640px) {
    .sub { padding: 38px 24px; border-radius: 16px; }
    .form { flex-direction: column; }
    button { padding: 14px; }
  }
</style>
