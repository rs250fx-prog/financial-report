---
import { DISCLAIMER, PUBLISHER, PUBLISHER_URL, IS_PUBLIC } from '../config';
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="disc">
      <b>免責事項</b>
      {DISCLAIMER}
    </div>
    <div class="fbot">
      <a href="/about/">このメディアについて</a>
      <a href="/about/#publisher">運営者情報</a>
      <a href="/privacy/">プライバシーポリシー</a>
      {IS_PUBLIC && <a href="/rss.xml">RSS</a>}
      <a href={PUBLISHER_URL}>fam16.com</a>
      <span>© {year} {PUBLISHER}</span>
    </div>
  </div>
</footer>

<style>
  footer { padding: 44px 0 66px; }
  .disc {
    background: var(--surface-2);
    border-radius: 12px;
    padding: 22px 26px;
    margin-bottom: 28px;
    font-size: 12.5px;
    line-height: 2.05;
    font-weight: 300;
    color: var(--muted);
  }
  .disc b {
    display: block;
    font-family: var(--sa);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: .16em;
    color: var(--ink-2);
    margin-bottom: 8px;
  }
  .fbot {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    font-family: var(--sa);
    font-size: 12px;
    color: var(--muted);
  }
  .fbot a { transition: color .16s; }
  .fbot a:hover { color: var(--ink); }
  .fbot span { margin-left: auto; }
  @media (max-width: 720px) {
    .fbot span { margin-left: 0; width: 100%; }
  }
</style>
