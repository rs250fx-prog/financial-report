---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import Snapshot from '../../components/Snapshot.astro';
import RailList from '../../components/RailList.astro';
import WeeklyPerformance from '../../components/WeeklyPerformance.astro';
import WeeklySchedule from '../../components/WeeklySchedule.astro';
import PriceLadder from '../../components/PriceLadder.astro';
import ScenarioCards from '../../components/ScenarioCards.astro';
import {
  allWeekly, listReports, monthDay, longDate, weekdayJa, shortTitle, tagSlug, isoJst,
} from '../../lib/content';
import { SITE_URL, OPERATOR, PUBLISHER_URL } from '../../config';

export async function getStaticPaths() {
  const entries = await allWeekly();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// その週に発行した日次レポート（古い順）を並べ、まとめから辿れるようにする
const reports = await listReports();
const inWeek = reports
  .filter((r) => r.data.date >= d.start && r.data.date <= d.end)
  .reverse();

const railItems = inWeek.map((r) => ({
  href: `/reports/${r.id}/`,
  meta: `${monthDay(r.data.date)}（${weekdayJa(r.data.date)}）No. ${r.data.no}`,
  title: shortTitle(r.data.title),
  value: r.data.headline && { text: r.data.headline.value, dir: r.data.headline.dir },
}));

const latest = reports[0];

const pageUrl = new URL(`/weekly/${entry.id}/`, SITE_URL).href;
const modifiedIso = isoJst(d.date ?? d.end, d.updated);
const schema = [
  {
    '@type': 'NewsArticle',
    '@id': `${pageUrl}#article`,
    headline: d.title,
    description: d.description || d.deck,
    datePublished: d.date ?? d.end,
    dateModified: modifiedIso ?? d.date ?? d.end,
    inLanguage: 'ja',
    isAccessibleForFree: d.access === 'public',
    articleSection: '週次まとめ',
    keywords: d.tags.join(', '),
    url: pageUrl,
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    image: new URL(d.ogImage ?? '/og-default.png', SITE_URL).href,
    author: { '@type': 'Organization', name: OPERATOR.name, url: PUBLISHER_URL },
    publisher: { '@id': `${SITE_URL}/#organization` },
    isPartOf: { '@id': `${SITE_URL}/#website` },
  },
];
const breadcrumbs = [{ name: '週次まとめ', path: '/weekly/' }, { name: d.title }];
---

<Base
  title={d.title}
  description={d.description || d.deck}
  type="article"
  ogImage={d.ogImage}
  publishedTime={d.date ?? d.end}
  modifiedTime={modifiedIso}
  unlisted={d.unlisted}
  schema={schema}
  breadcrumbs={breadcrumbs}
  quotes={latest?.data.snapshot ?? []}
  mastDate={latest?.data.date}
  mastNo={latest?.data.no}
>
  <div class="wrap">
    {/* 日次の記事ページと同じ骨組み。右列には週の数値（寸評なし）と、
        この週の日次レポートを置く。寸評つきの表は本文側に残す */}
    <div class="article-layout">
    <div class="article-main">
    <article>
      <nav class="crumb" aria-label="パンくず">
        <a href="/">ホーム</a>
        <span aria-hidden="true">/</span>
        <a href="/weekly/">週次まとめ</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">WEEK {d.week}</span>
      </nav>

      <header class="head">
        <div class="rubric">
          <span class="num">WEEK {d.week}</span>
          <span class="rule" aria-hidden="true"></span>
          <span class="num">{monthDay(d.start)} — {monthDay(d.end)}</span>
        </div>
        <h1>{d.title}</h1>
        <p class="deck">{d.deck}</p>
        <div class="by">
          <span>Financial and Marketing M16</span>
          <span>{longDate(d.date ?? d.end)} 発行</span>
          {d.updated && <span>更新 {d.updated}</span>}
        </div>
        {d.tags.length > 0 && (
          <div class="tags">
            {d.tags.map((t) => <a href={`/topics/${tagSlug(t)}/`}>{t}</a>)}
          </div>
        )}
      </header>

      {d.points.length > 0 && (
        <section class="points" aria-label="今週の要点">
          <div class="points-h">今週の要点</div>
          <ol>
            {d.points.map((p) => <li>{p}</li>)}
          </ol>
        </section>
      )}

      <WeeklyPerformance rows={d.performance} />

      <PriceLadder levels={d.levels} label="テクニカル・レベル（週末時点）" />

      <div class="prose">
        <Content />
      </div>

      <div class="prose">
        <ScenarioCards scenarios={d.scenarios} />
        <WeeklySchedule days={d.schedule} />
      </div>

      {d.bias && (
        <section class="bias">
          <div class="bias-h">Market Bias（来週）</div>
          <p>{d.bias}</p>
        </section>
      )}
    </article>

    </div>

    <aside class="article-rail">
      <div class="article-rail-in">
        <div class="rail-only">
          <Snapshot quotes={d.performance} variant="list" heading="週の数値" />
        </div>
        <RailList
          heading="この週の日次レポート"
          items={railItems}
          moreHref="/reports/"
          moreLabel="アーカイブへ →"
          clamp={1}
        />
      </div>
    </aside>
    </div>

    <Subscribe />
  </div>
</Base>

<style>
  article { padding-top: 34px; }
  .crumb {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    font-family: var(--sa);
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 22px;
  }
  .crumb a:hover { color: var(--accent); }
  .rubric {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--sa);
    font-size: 11px;
    letter-spacing: .14em;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .rubric .rule { flex: 1; height: 1px; background: var(--line); display: block; }
  h1 {
    font-family: var(--se);
    font-size: clamp(27px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.42;
    margin-bottom: 22px;
    max-width: 24ch;
  }
  .deck {
    font-size: 17px;
    line-height: 1.9;
    font-weight: 400;
    color: var(--ink-2);
    max-width: 58ch;
    margin-bottom: 26px;
  }
  .by {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--sa);
    font-size: 11.5px;
    color: var(--muted);
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .tags { margin-top: 14px; }
  .prose { max-width: 68ch; padding: 34px 0 0; }

  /* 今週の要点。日次と同じ見せ方で揃える */
  .points {
    margin: 34px 0 0;
    background: var(--surface-2);
    border-radius: var(--r);
    padding: 28px 32px;
  }
  .points-h {
    font-family: var(--sa);
    font-size: 10.5px;
    letter-spacing: .16em;
    color: var(--muted);
    padding-bottom: 12px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--line-2);
  }
  .points ol { list-style: none; counter-reset: pt; }
  .points li {
    counter-increment: pt;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 6px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.9;
    color: var(--ink-2);
  }
  .points li:last-child { border-bottom: 0; }
  .points li::before {
    content: counter(pt, decimal-leading-zero);
    font-family: var(--sa);
    font-size: 10.5px;
    letter-spacing: .1em;
    color: var(--accent);
  }

  /* 来週のスタンス。記事の結論なので一番強く出す */
  .bias {
    margin: 10px 0 56px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--r);
    padding: 26px 30px;
  }
  .bias-h {
    font-family: var(--sa);
    font-size: 10.5px;
    letter-spacing: .16em;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .bias p {
    font-size: 16px;
    line-height: 2;
    color: var(--ink);
  }
</style>
