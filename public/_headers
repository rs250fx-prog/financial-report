# Cloudflare Pages のレスポンスヘッダ設定。
#
# 2026-09-22 に本公開したため X-Robots-Tag は外してある。
# 非公開へ戻す場合は、src/config.ts の IS_PUBLIC を false に戻すのと
# セットで、下に X-Robots-Tag: noindex, nofollow を復活させること。
# 片方だけだとサイトマップと noindex が矛盾し、Search Console が
# エラーを出す。

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# 内容が変わればファイル名も変わる（ハッシュ付き）ため、
# 長期キャッシュして再取得させない
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# フォントは差し替えるときにファイル名を変える運用にする
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=604800

# note 用サムネイル（tools/copy-thumbs.mjs が dist/thumb/ に写す）。
# note に貼るための画像で、検索結果に出す必要はない。文言を直して出し直すことが
# あるので長くキャッシュしない
/thumb/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=300
